# Server Port & Public URL (Change BASE_URL to your live domain when deployed)
PORT=3000
BASE_URL=http://localhost:3000

# SSLCommerz Credentials (Get Sandbox credentials from https://developer.sslcommerz.com/registration/)
SSLCOMMERZ_STORE_ID=your_store_id
SSLCOMMERZ_STORE_PASSWD=your_store_password
SSLCOMMERZ_IS_LIVE=false

# Courier Selection: auto | steadfast | pathao | redx | ecourier
COURIER_PROVIDER=auto
COURIER_AUTO_BOOK=true

# 1. Steadfast Courier (https://portal.packzy.com)
STEADFAST_API_KEY=your_steadfast_api_key
STEADFAST_SECRET_KEY=your_steadfast_secret_key

# 2. Pathao Courier (https://merchant.pathao.com)
PATHAO_IS_LIVE=true
PATHAO_CLIENT_ID=your_pathao_client_id
PATHAO_CLIENT_SECRET=your_pathao_client_secret
PATHAO_USERNAME=your_pathao_email
PATHAO_PASSWORD=your_pathao_password
PATHAO_STORE_ID=your_pathao_store_id

# 3. RedX Courier (https://redx.com.bd/developer-api/)
REDX_IS_LIVE=true
REDX_API_TOKEN=your_redx_jwt_token
REDX_DEFAULT_AREA=Dhaka
REDX_DEFAULT_AREA_ID=1

# 4. eCourier (https://backoffice.ecourier.com.bd)
ECOURIER_IS_LIVE=true
ECOURIER_API_KEY=your_ecourier_api_key
ECOURIER_API_SECRET=your_ecourier_api_secret
ECOURIER_USER_ID=your_ecourier_user_id
ECOURIER_PACKAGE_CODE=your_ecourier_package_code
ECOURIER_DEFAULT_CITY=Dhaka
ECOURIER_DEFAULT_THANA=Dhaka
ECOURIER_DEFAULT_AREA=Dhaka

# Admin key for viewing /api/orders and /api/consultations
ADMIN_KEY=aureva-admin-2026

# Permanent Free Cloud Database (Upstash Redis - https://upstash.com)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
